# Cannvas owns the fullscreen touchscreen session on this Pi.
# Use this session's compositor, never a greeter or an older Labwc process.
/usr/bin/labwc -r
/usr/bin/sleep 1
# The TV exposes its real 1080p mode only after CEC wakes it. Keep this in the
# foreground so the kiosk cannot size itself against the landscape fallback.
/usr/local/bin/cannvas-display-wake >/tmp/cannvas-display-wake.log 2>&1
# Import the fresh socket after each desktop login. A persistent user service
# restarts Chromium if it exits, including after a compositor failure.
/usr/bin/systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR
/usr/bin/systemctl --user restart cannvas-keyboard.service cannvas-kiosk.service
